	(text
		"1. Input: USB-C PD sink requests 12 V / 3 A (36 W). Buck EN divider (100k/15k) holds the 5 V rail off below ~9 V,"
		(exclude_from_sim no)
		(at 25.4 195.58 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f2fe9690-e897-56a6-b490-8131b4dee938")
	)
	(text
		"   so a non-PD 5 V source can never back-feed the CM5 at low voltage."
		(exclude_from_sim no)
		(at 25.4 200.66 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "877c88e4-6c93-5014-bd15-866c038bdf19")
	)
	(text
		"2. CM5 CC1/CC2 left open: set usb_max_current_enable=1 in config.txt to allow 1.6 A on the USB-A ports."
		(exclude_from_sim no)
		(at 25.4 205.74 0)
		(effects
